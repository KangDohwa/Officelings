<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="Officelings.Core"><HintPath>$(CoreDll)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireCoreAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CoreDll)' == '' Or !Exists('$(CoreDll)')" Text="Supply CoreDll with an already built Release assembly." />
  </Target>
</Project>
